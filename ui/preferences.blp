using Gtk 4.0;
using Adw 1;

Adw.PreferencesDialog dialog {
  title: "Preferences";
  content-width: 640;
  content-height: 360;

  Adw.PreferencesPage {
    Adw.PreferencesGroup {
      title: "GitHub";
      description: "A personal access token raises GitHub's rate limit from 60 to 5,000 requests an hour. <a href='https://github.com/settings/personal-access-tokens/new?name=Gextant&amp;description=Reads+the+releases+of+GNOME+Shell+extensions&amp;expires_in=366'>Create a fine-grained token</a> with Repository access set to Public repositories and no permissions. To check private repositories as well, select them and allow Contents: Read-only. The token is kept in your keyring.";

      Adw.PasswordEntryRow token_row {
        title: "Access Token";
        show-apply-button: true;
      }
    }
  }
}
