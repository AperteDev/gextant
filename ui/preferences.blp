using Gtk 4.0;
using Adw 1;

Adw.PreferencesDialog dialog {
  title: "Preferences";
  content-width: 640;
  content-height: 360;

  Adw.PreferencesPage {
    Adw.PreferencesGroup {
      title: "GitHub";
      description: "A personal access token raises GitHub's rate limit from 60 to 5,000 requests an hour. Create a fine-grained token <a href='https://github.com/settings/personal-access-tokens/new?name=Gextant&amp;expires_in=366&amp;description=Reads+the+releases+of+public+GNOME+Shell+extensions'>for public repositories</a> (set Repository access to Public repositories) or <a href='https://github.com/settings/personal-access-tokens/new?name=Gextant&amp;expires_in=366&amp;description=Reads+the+releases+of+GNOME+Shell+extensions,+private+ones+too&amp;contents=read'>for private ones too</a> (select them under Repository access; Contents: Read-only is filled in). The token lasts a year, the longest some organisations allow, and is kept in your keyring.";

      Adw.PasswordEntryRow token_row {
        title: "Access Token";
        show-apply-button: true;
      }
    }
  }
}
