using Gtk 4.0;
using Adw 1;

Adw.ApplicationWindow window {
  default-width: 720;
  default-height: 720;
  title: "Gextant";

  content: Adw.ToolbarView {
    [top]
    Adw.HeaderBar {
      [start]
      Gtk.Button refresh_button {
        icon-name: "view-refresh-symbolic";
        tooltip-text: "Check for Updates";
      }

      [end]
      Gtk.MenuButton {
        icon-name: "open-menu-symbolic";
        primary: true;
        menu-model: primary_menu;
      }
    }

    [top]
    Adw.Banner banner {
      button-label: "Preferences";
      action-name: "win.preferences";
    }

    content: Gtk.Stack stack {
      Gtk.StackPage {
        name: "empty";

        child: Adw.StatusPage {
          icon-name: "dev.aperte.Gextant";
          title: "No Extensions Installed";
          description: "Keeps your GNOME extensions up to date, straight from their repositories.";
        };
      }

      Gtk.StackPage {
        name: "list";

        child: Adw.PreferencesPage {
          Adw.PreferencesGroup user_group {
            title: "User-Installed Extensions";
          }

          Adw.PreferencesGroup system_group {
            title: "System Extensions";
          }
        };
      }
    };
  };
}

menu primary_menu {
  item {
    label: "Preferences";
    action: "win.preferences";
  }

  item {
    label: "Quit";
    action: "app.quit";
  }
}
